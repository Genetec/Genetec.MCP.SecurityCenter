# Compose loads .env; native runs require these as process environment variables.
# See README.md for configuration precedence and advanced settings.

SecurityCenter__WebSdkSettings__Hosts__0=localhost
SecurityCenter__WebSdkSettings__Port=4590
SecurityCenter__WebSdkSettings__UseHttps=true
SecurityCenter__WebSdkSettings__SkipCertificateValidation=false
SecurityCenter__WebSdkSettings__InvokeTimeoutSec=30

# Native transport; Compose selects HTTP.
Transport__Stdio__Enabled=false
Transport__Http__Enabled=true
Serilog__MinimumLevel__Override__WebSdk=Information

# Docker HTTPS: mount certs/server.pfx.
Kestrel__Endpoints__Https__Certificate__Password=your-server-pfx-password
