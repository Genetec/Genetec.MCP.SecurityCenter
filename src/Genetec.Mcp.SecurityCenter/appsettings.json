{
  "SecurityCenter": {
    "WebSdkSettings": {
      "Hosts": ["localhost"],
      "Port": 4590,
      "InvokeTimeoutSec": 30,
      "SkipCertificateValidation": false
    }
  },
  "Transport": {
    "Stdio": { "Enabled": true },
    "Http": { "Enabled": false }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5000"
      }
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "McpMaxConcurrentPerUser": 5,
    "McpConcurrencyWaitSeconds": 30,
    "McpWindowCallLimit": 200,
    "McpWindowMinutes": 5
  },
  "Authentication": {
    "TokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7,
    "Issuer": "GenetecSecurityCenter",
    "Audience": "GenetecSecurityCenter"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "WebSdk": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "standardErrorFromLevel": "Verbose" }
      },
      {
        "Name": "File",
        "Args": {
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
